{
  "name": "@joelvaneenwyk/homepage",
  "version": "2.0.2",
  "private": true,
  "description": "Homepage for Joel Van Eenwyk",
  "keywords": [
    "homepage",
    "nodejs",
    "hugo",
    "portfolio",
    "résumé"
  ],
  "homepage": "https://www.joelvaneenwyk.com",
  "bugs": {
    "url": "https://github.com/joelvaneenwyk/workspace/issues",
    "email": "joel.vaneenwyk@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joelvaneenwyk/homepage.git"
  },
  "license": "MIT",
  "author": {
    "name": "Joel Van Eenwyk",
    "email": "joel.vaneenwyk@gmail.com"
  },
  "type": "module",
  "main": "dist/server/server.js",
  "workspaces": [
    "homepage",
    "src/server",
    "src/tools"
  ],
  "packageManager": "yarn@4.3.1+sha512.af78262d7d125afbfeed740602ace8c5e4405cd7f4735c08feb327286b2fdb2390fbca01589bfd1f50b1240548b74806767f5a063c94b67e431aabd0d86f7774",
  "engines": {
    "node": "^18 || ^20 || ^21 || ^22"
  },
  "scripts": {
    "build": "concurrently -m 1 \"yarn:build:*\"",
    "build:end": "echo Building steps completed...",
    "build:hugo": "hugo --cleanDestinationDir --enableGitInfo --forceSyncStatic --gc --logLevel=debug --buildDrafts --buildExpired --buildFuture",
    "build:pretty": "yarn prettier --config ./prettier.config.mjs --write \"**/*\"",
    "build:server": "yarn workspace @joelvaneenwyk/tools build",
    "build:start": "echo \"Building typescript server and website...\"",
    "build:theme": "yarn run build:theme:babel && yarn run build:theme:segmentit",
    "build:theme:babel": "cd themes/base && babel src/js --out-file assets/js/theme.min.js --source-maps",
    "build:theme:segmentit": "cd themes/base && browserify src/lib/lunr.segmentit.js -o assets/lib/lunr/lunr.segmentit.js -t babelify --presets @babel/preset-env --presets minify",
    "dev": "yarn sdks vscode",
    "generate": "yarn run hugo && yarn run build",
    "github": "act",
    "hugo": "hugo --cleanDestinationDir --enableGitInfo --forceSyncStatic",
    "lint": "eslint --debug --no-warn-ignored --config \"./eslint.config.mjs\" *.mjs src/**/*.*",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "refresh": "shx rm yarn.lock && yarn install",
    "reinstall": "yarn cache clean --all && yarn install",
    "start": "ts-node ./src/server/server.ts",
    "start-dev": "tsc && ts-node ./src/server/server.ts",
    "test": "yarn \"build:server\" && node --require=./.pnp.cjs ./dist/server/server.js --test",
    "upgrade": "npx -y npm-check-updates@latest -u && yarn install && npx -y yarn-audit-fix@latest && yarn run build:pretty",
    "watch": "hugo --cleanDestinationDir --enableGitInfo --forceSyncStatic"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": "> 0.25%, not dead"
        }
      ],
      "minify"
    ]
  },
  "dependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.24.9",
    "@babel/preset-env": "^7.25.0",
    "@eslint/js": "^9.8.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@toml-tools/lexer": "^1.0.0",
    "@types/eslint__js": "^8.42.3",
    "@types/finalhandler": "^1",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^20.14.12",
    "@types/node-static": "^0.7.11",
    "@types/serve-static": "^1",
    "@yarnpkg/cli": "^4.3.1",
    "@yarnpkg/core": "^4.1.1",
    "@yarnpkg/esbuild-plugin-pnp": "^3.0.0-rc.15",
    "@yarnpkg/plugin-git": "^3.0.0",
    "@yarnpkg/plugin-workspace-tools": "^4.1.0",
    "@yarnpkg/pnpify": "^4.1.0",
    "@yarnpkg/sdks": "^3.1.3",
    "babel-preset-minify": "^0.5.2",
    "babelify": "^10.0.0",
    "browserify": "^17.0.0",
    "concurrently": "^8.2.2",
    "core-js": "^3.37.1",
    "esbuild": "^0.23.0",
    "esbuild-plugin-tsc": "^0.4.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-node": "*",
    "eslint-plugin-import": "*",
    "eslint-plugin-prettier": "^5.2.1",
    "finalhandler": "^1.2.0",
    "globals": "^15.8.0",
    "htmlhint": "^1.1.4",
    "husky": "^9.1.5",
    "js-beautify": "^1.15.1",
    "minimist": "^1.2.8",
    "node-gyp": "^10.2.0",
    "pinst": "^3.0.0",
    "postcss": "^8.4.40",
    "postcss-html": "^1.7.0",
    "postcss-markdown": "^1.2.0",
    "postcss-syntax": "^0.36.2",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.3.0",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-packagejson": "^2.5.1",
    "prettier-plugin-sh": "^0.14.0",
    "prettier-plugin-toml": "^2.0.1",
    "segmentit": "^2.0.3",
    "serve-static": "^1.15.0",
    "shx": "^0.3.4",
    "stylelint": "*",
    "stylelint-config-recommended": "*",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4",
    "typescript-bundle": "^1.0.18",
    "typescript-eslint": "^7.17.0",
    "yarn-audit-fix": "^10.0.7"
  }
}
