{
  "name": "@joelvaneenwyk/homepage",
  "version": "2.0.2",
  "private": true,
  "description": "Homepage for Joel Van Eenwyk",
  "keywords": [
    "homepage",
    "nodejs",
    "hugo",
    "portfolio",
    "résumé"
  ],
  "homepage": "https://joelvaneenwyk.com",
  "bugs": {
    "url": "https://github.com/joelvaneenwyk/workspace/issues",
    "email": "joel.vaneenwyk@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joelvaneenwyk/homepage.git"
  },
  "license": "MIT",
  "author": {
    "name": "Joel Van Eenwyk",
    "email": "joel.vaneenwyk@gmail.com"
  },
  "type": "module",
  "main": "dist/server/server.js",
  "workspaces": [
    "homepage",
    "src/server",
    "src/tools"
  ],
  "scripts": {
    "build": "concurrently -m 1 \"yarn:build:*\"",
    "build:hugo": "hugo --cleanDestinationDir --enableGitInfo --forceSyncStatic --gc --logLevel=debug --buildDrafts --buildExpired --buildFuture",
    "build:pretty": "prettier --config ./prettier.config.mjs --write \"**/*\"",
    "build:server": "yarn workspace @joelvaneenwyk/tools build",
    "build:theme": "npm run build:theme:babel && npm run build:theme:segmentit",
    "build:theme:babel": "cd themes/base && babel src/js --out-file assets/js/theme.min.js --source-maps",
    "build:theme:segmentit": "cd themes/base && browserify src/lib/lunr/lunr.segmentit.js -o assets/lib/lunr/lunr.segmentit.js -t babelify --presets @babel/preset-env --presets minify",
    "generate": "npm run hugo && npm run build",
    "github": "act",
    "hugo": "hugo --cleanDestinationDir --enableGitInfo --forceSyncStatic",
    "lint": "eslint --debug --no-warn-ignored --config \"./eslint.config.mjs\" *.mjs src/**/*.*",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "refresh": "shx rm yarn.lock && npm run refresh:install",
    "refresh:install": "yarn install",
    "reinstall": "yarn cache clean --all && npm run refresh:install",
    "start": "ts-node ./src/server/server.ts",
    "start-dev": "tsc && ts-node ./src/server/server.ts",
    "test": "npm run \"build:server\" && node --require=./.pnp.cjs ./dist/server/server.js --test",
    "upgrade": "npx -y npm-check-updates@latest -u && npm run refresh:install && npx -y yarn-audit-fix@latest && npm run build:pretty",
    "watch": "hugo --cleanDestinationDir --enableGitInfo --forceSyncStatic"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": "> 0.25%, not dead"
        }
      ],
      "minify"
    ]
  },
  "dependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.8",
    "@babel/preset-env": "^7.26.8",
    "@eslint/js": "^9.20.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@toml-tools/lexer": "^1.0.0",
    "@types/eslint__js": "^8.42.3",
    "@types/finalhandler": "^1",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^22.13.9",
    "@types/node-static": "^0.7.11",
    "@types/serve-static": "^1",
    "@yarnpkg/cli": "^4.6.0",
    "@yarnpkg/core": "^4.2.0",
    "@yarnpkg/esbuild-plugin-pnp": "^3.0.0-rc.15",
    "@yarnpkg/plugin-git": "^3.1.0",
    "@yarnpkg/plugin-workspace-tools": "^4.1.2",
    "@yarnpkg/pnpify": "^4.1.3",
    "@yarnpkg/sdks": "^3.2.0",
    "babel-preset-minify": "^0.5.2",
    "babelify": "^10.0.0",
    "browserify": "^17.0.1",
    "concurrently": "^9.1.2",
    "core-js": "^3.40.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-tsc": "^0.4.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-node": "*",
    "eslint-plugin-import": "*",
    "eslint-plugin-prettier": "^5.2.3",
    "finalhandler": "^1.3.1",
    "globals": "^15.15.0",
    "htmlhint": "^1.1.4",
    "husky": "^9.1.7",
    "js-beautify": "^1.15.3",
    "minimist": "^1.2.8",
    "node-gyp": "^11.1.0",
    "pinst": "^3.0.0",
    "postcss": "^8.5.2",
    "postcss-html": "^1.8.0",
    "postcss-markdown": "^1.3.0",
    "postcss-syntax": "^0.36.2",
    "prettier": "^3.5.0",
    "prettier-eslint": "^16.3.0",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.8",
    "prettier-plugin-sh": "^0.14.0",
    "prettier-plugin-toml": "^2.0.1",
    "segmentit": "^2.0.3",
    "serve-static": "^1.16.2",
    "shx": "^0.3.4",
    "stylelint": "*",
    "stylelint-config-recommended": "*",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-bundle": "^1.0.18",
    "typescript-eslint": "^8.24.0",
    "yarn-audit-fix": "^10.1.1"
  },
  "packageManager": "yarn@4.6.0+sha512.5383cc12567a95f1d668fbe762dfe0075c595b4bfff433be478dbbe24e05251a8e8c3eb992a986667c1d53b6c3a9c85b8398c35a960587fbd9fa3a0915406728",
  "engines": {
    "node": "^18 || ^20 || ^21 || ^22",
    "npm": ">=10",
    "yarn": ">=4"
  }
}
