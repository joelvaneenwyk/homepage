hugo = "0.124.1"
node = "21.7.3"
npm = "10.5.2"
shellcheck = "0.10.0"
shfmt = "3.8.0"
yarn = "4.1.1"

[plugins]
hugo = "source:https://raw.githubusercontent.com/z0rrn/proto-plugins/main/hugo/plugin-extended.toml"
shellcheck = "source:https://raw.githubusercontent.com/Phault/proto-toml-plugins/main/shellcheck/plugin.toml"
shfmt = "source:https://raw.githubusercontent.com/Phault/proto-toml-plugins/main/shfmt/plugin.toml"
