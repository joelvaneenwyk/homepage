// Place your settings in this file to overwrite default and user settings.
{
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[javascript][typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll": "explicit"
    }
  },
  "css.validate": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.detectIndentation": false,
  "editor.formatOnSave": false,
  "editor.insertSpaces": true,
  "editor.mouseWheelScrollSensitivity": 1,
  "eslint.alwaysShowStatus": true,
  "eslint.experimental.useFlatConfig": true,
  "eslint.format.enable": true,
  "eslint.lintTask.enable": true,
  "eslint.nodePath": ".yarn/sdks",
  "eslint.run": "onSave",
  "files.associations": {
    "*.json.git": "jsonc",
    ".eslintrc.json": "jsonc",
    "cspell.json": "jsonc",
    "LICENSE": "text",
    "Procfile": "yaml",
    "tsconfig.json": "jsonc"
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.heroku": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/.yarn/cache": true,
    "**/bower_components": true,
    "**/node_modules": true
  },
  "htmlhint.enable": false,
  "json.format.enable": true,
  "liveServer.settings.ignoreFiles": [
    ".vscode/**",
    ".tmp/**",
    "backup/**",
    ".yarn/**",
    "themes/**",
    "**/*.scss",
    "**/*.sass",
    "**/*.ts"
  ],
  "liveServer.settings.port": 13555,
  "liveServer.settings.root": "/dist/www",
  "perl.enable": false,
  "prettier.enable": true,
  "prettier.prettierPath": ".yarn/sdks/prettier/index.cjs",
  "python.dataScience.alwaysScrollOnNewCell": false,
  "search.exclude": {
    "**/*.code-search": true,
    "**/*.min.css": true,
    "**/*.min.js": true,
    "**/*.min.js.map": true,
    "**/*.svg": true,
    "**/.pnp.*": true,
    "**/.yarn": true,
    "**/backup/**": true,
    "**/bower_components/**": true,
    "**/cheeses/output/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "themes/base/assets/**/*.css": true,
    "themes/base/assets/**/*.js": true,
    "yarn.lock": true
  },
  "sortJSON.excludedFiles": ["package.json", "settings.json"],
  "stylelint.enable": false,
  "stylelint.stylelintPath": ".yarn/sdks/stylelint/lib/index.js",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsdk": ".yarn/sdks/typescript/lib"
}
